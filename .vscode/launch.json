{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Deploy: Deploy to Azure (PowerShell)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/scripts/deploy.ps1",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Web App (port 8080)",
            "type": "debugpy",
            "request": "launch",
            "module": "job_agent.webapp",
            "console": "integratedTerminal",
            "justMyCode": false,
             "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "API Server (port 8088)",
            "type": "debugpy",
            "request": "launch",
            "module": "job_agent.server",
             "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Debug: Cron Job Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_cron.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Debug: CLI Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_cli.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Debug: E2E Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_e2e.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Attach to Python Functions",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 9091
            },
            "preLaunchTask": "func: host start"
        }
    ]
}